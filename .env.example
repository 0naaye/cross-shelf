# ─────────────────────────────────────────────────────────────
# 인증키 설정 견본 파일
#
# 사용법: 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤,
#         아래 = 뒤에 발급받은 키를 따옴표 없이 붙여넣고 저장하세요.
#
#   Windows :  copy .env.example .env
#   macOS/Linux :  cp .env.example .env
#
# ※ .env 는 절대 공유·업로드하지 마세요.
# ※ 첨부된 data_raw/ 의 원본 응답 캐시만으로 재현되는 단계가 많습니다.
#    어떤 단계에 키가 필요한지는 README.md 의 실행 순서 표를 보세요.
# ─────────────────────────────────────────────────────────────

# 1) 도서관 정보나루 Open API 인증키
#    발급: https://www.data4library.kr/apiUtilization
#          (회원가입 → 인증키 신청 → 승인까지 시간이 걸립니다)
#    쓰이는 곳: 00 · 01 · 02 · 03 · 05 · 10 · 11 단계
DATA4LIBRARY_AUTH_KEY=

# 2) 국립중앙도서관 ISBN 서지정보(seoji) API 인증키
#    발급: https://www.nl.go.kr/NL/contents/N31101030500.do
#          (정보나루 키와는 완전히 별개입니다)
#    쓰이는 곳: 07 · 08 · 09 단계 (부가기호 = 독자대상·발행형태)
NL_SEOJI_CERT_KEY=
